# Copy to .env for local runs. .env is gitignored and must stay that way.
# In CI these are GitHub Secrets, never files.

# Alpaca paper trading credentials.
# Create a FRESH paper account for the hackathon and set its balance to $100,000
# - submissions running on a reused account are not eligible for judging.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true

# The paper account ID that goes into the lablab submission form.
ALPACA_ACCOUNT_ID=

# --- Models -----------------------------------------------------------------
#
# Set at least one. Set two from different model families and the Risk Officer
# becomes a genuinely independent reviewer instead of the Proposer talking to
# itself; with only one family the verdict is stamped "degraded" and says so.
#
# The first key present, in the order listed in agents/llm.py, is used by the
# Proposer; the Risk Officer takes the first one from a different family.
#
# Free, no card, two minutes each:
#   GEMINI - aistudio.google.com/apikey   (Google lineage, ~1,500 requests/day)
#   GROQ   - console.groq.com/keys        (open weights, ~1,000 requests/day)
GEMINI_API_KEY=
GROQ_API_KEY=

# Paid or credit-funded, all optional.
ANTHROPIC_API_KEY=
FEATHERLESS_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# Pin a role to one provider by name, e.g. ONENODE_PROPOSER_PROVIDER=gemini with
# ONENODE_REVIEWER_PROVIDER=groq. Left empty, the order above decides.
ONENODE_PROPOSER_PROVIDER=
ONENODE_REVIEWER_PROVIDER=

# Pin one provider's model, e.g. ONENODE_GEMINI_MODEL=gemini-2.5-flash. Left
# empty, the model is discovered from the provider's live catalogue - which is
# what survives a model being retired mid-week.

# Set to 1 to build and validate orders without ever submitting them.
ONENODE_DRY_RUN=
